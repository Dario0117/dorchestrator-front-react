{
  "name": "dorchestrator-front-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:debug": "VITE_IS_VSCODE_DEBUG=true vite",
    "test": "vitest",
    "test:forAgents": "VITEST_IS_AGENT_TEST=true vitest",
    "coverage": "vitest run --coverage",
    "check-ts": "tsc -b --noEmit",
    "build": "tsc -b && vite build",
    "format:fix": "biome format --write .",
    "lint:fix": "biome lint --write .",
    "format-and-lint:fix": "biome check --write .",
    "format-and-lint:check": "biome check",
    "preview": "vite preview",
    "open-api": "openapi-typescript http://localhost:9000/openapi/json --output ./src/types/api.generated.types.ts",
    "dead-code": "knip --reporter compact"
  },
  "dependencies": {
    "@base-ui/react": "1.3.0",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "5.2.8",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/core": "2.5.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.211.0",
    "@opentelemetry/resources": "2.5.0",
    "@opentelemetry/sdk-trace-base": "2.5.0",
    "@opentelemetry/sdk-trace-web": "2.5.0",
    "@opentelemetry/semantic-conventions": "1.39.0",
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/vite": "4.1.10",
    "@tanstack/react-form": "1.12.3",
    "@tanstack/react-hotkeys": "0.4.2",
    "@tanstack/react-query": "5.81.2",
    "@tanstack/react-query-devtools": "5.81.2",
    "@tanstack/react-router": "1.127.3",
    "@tanstack/react-router-devtools": "1.127.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "better-auth": "1.4.9",
    "centrifuge": "5.5.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "immer": "10.1.1",
    "lucide-react": "0.525.0",
    "openapi-fetch": "0.14.0",
    "openapi-react-query": "0.5.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.1.10",
    "zod": "4.0.5",
    "zustand": "5.0.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.4",
    "@tanstack/router-plugin": "1.127.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.0.10",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.3",
    "@vitejs/plugin-react": "4.4.1",
    "@vitest/coverage-v8": "4.0.17",
    "globals": "16.0.0",
    "jsdom": "26.1.0",
    "knip": "5.86.0",
    "msw": "2.12.7",
    "openapi-typescript": "7.9.1",
    "shadcn": "4.0.8",
    "tw-animate-css": "1.4.0",
    "typescript": "5.7.3",
    "vite": "6.3.4",
    "vite-plugin-checker": "0.10.0",
    "vitest": "4.0.17"
  }
}
