# Backend API Configuration
# REQUIRED: The base URL for the backend API
# Example for local development: http://localhost:9000
# Example for production: https://api.production.com
VITE_BACKEND_BASE_URL=

# Frontend Configuration
# REQUIRED: The base URL for the frontend application
# Used for redirect URLs in authentication flows
# Example for local development: http://localhost:5173
# Example for production: https://app.production.com
VITE_FRONTEND_BASE_URL=

# Development Configuration (Optional)
# Set to true when debugging with VSCode to disable code splitting
# Uncomment and set to true only when needed
# VITE_IS_VSCODE_DEBUG=true

# Testing Configuration (Optional)
# Set to true when running tests via Claude Code or other agents
# Disables parallel execution to prevent resource exhaustion
# Uncomment and set to true only when needed
# VITEST_IS_AGENT_TEST=true
